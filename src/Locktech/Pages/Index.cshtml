@page
@model IndexModel
@{
    ViewData["Title"] = "Locktech — Akıllı Kilit Sistemleri | GPS Takipli Elektronik Kilit";
    ViewData["Description"] = "Konteyner, tanker ve kamyon kasaları için 4G, GNSS, Bluetooth ve RFID destekli akıllı elektronik kilitler ve video telematik. Locktech, Ankara.";
}

<div class="hero"><div class="wrap">
  <div>
    <span class="eyebrow">4G · GNSS · Bluetooth · RFID</span>
    <h1>Akıllı Güvenlik,<br>Lojistikte <em>Yeni Standart</em></h1>
    <p class="lead">Konteyner, tanker ve kamyon kasalarınızı nerede olursa olsun izleyin. Locktech elektronik kilitleri konumu anlık bildirir, yalnızca yetkili kişiye açılır ve her açma-kapama işlemini kayıt altına alır.</p>
    <div class="cta">
      <a class="btn btn-primary" href="#teklif">Teklif İste <svg class="i"><use href="#arrow"/></svg></a>
      <a class="btn btn-ghost" href="#urunler">Ürünleri İncele</a>
    </div>
    <div class="chips"><span>IP67 su geçirmez</span><span>ATEX · Ex-proof gövde</span><span>CE</span><span>1.000 kg kilit mili dayanımı</span></div>
  </div>
  <div class="stage">
    <div class="ring"></div>
    <div class="card"><img src="~/img/hb-a1sp.jpg" alt="HB-A1SP güneş enerjili elektronik kilit"></div>
    <div class="float f1"><span class="dot"></span><span><small>Kilit durumu</small><b>Kilitli</b></span></div>
    <div class="float f2"><svg class="i"><use href="#pin"/></svg><span><small>Canlı konum</small><b>Ankara → Mersin</b></span></div>
    <div class="float f3"><svg class="i"><use href="#bell"/></svg><span><small>Bildirim</small><b>Yetkisiz açma denemesi</b></span></div>
  </div>
</div></div>

<div class="strip"><div class="wrap"><div class="grid">
  <div class="cell"><svg class="i"><use href="#pin"/></svg>GPS Takip</div>
  <div class="cell"><svg class="i"><use href="#mobile"/></svg>Mobil Kontrol</div>
  <div class="cell"><svg class="i"><use href="#card"/></svg>Kartlı Erişim</div>
  <div class="cell"><svg class="i"><use href="#monitor"/></svg>Merkezi Yönetim</div>
  <div class="cell"><svg class="i"><use href="#bell"/></svg>Anlık Bildirim</div>
  <div class="cell"><svg class="i"><use href="#link"/></svg>Çoklu Kilit Zincirleme</div>
</div></div></div>

<section class="products" id="urunler"><div class="wrap">
  <div class="sec-head">
    <div><span class="eyebrow">Ürünler</span><h2>Dört ürün, uçtan uca yük güvenliği</h2></div>
    <p>Ana kilit, ikincil kilit ve araç içi video telematik. Her ürünün teknik föyü kendi sayfasından PDF olarak indirilebilir.</p>
  </div>
  <div class="pgrid">
    <a class="pcard" href="#">
      <div class="pic"><span class="tag o">GÜNEŞ ENERJİLİ</span><img src="~/img/hb-a1sp.jpg" alt="HB-A1SP"></div>
      <div class="body">
        <div class="model">HB-A1SP</div>
        <h3>4G Güneş Enerjili Elektronik Kilit</h3>
        <ul><li>15.200 mAh batarya, güneş paneliyle şarj</li><li>RFID kart, Bluetooth ve 4G uzaktan açma</li><li>IP67, patlamaya dayanıklı (Ex) gövde</li></ul>
        <div class="more"><span>İncele →</span><span>PDF föy</span></div>
      </div>
    </a>
    <a class="pcard" href="#">
      <div class="pic"><span class="tag">KOMPAKT</span><img src="~/img/hb-a1m.jpg" alt="HB-A1M"></div>
      <div class="body">
        <div class="model">HB-A1M</div>
        <h3>4G Patlamaya Dayanıklı Elektronik Kilit</h3>
        <ul><li>544 g, 124 × 95 × 47 mm</li><li>20 gün bekleme süresi</li><li>Cascade ile çoklu kilit zincirleme</li></ul>
        <div class="more"><span>İncele →</span><span>PDF föy</span></div>
      </div>
    </a>
    <a class="pcard" href="#">
      <div class="pic"><span class="tag">İKİNCİL KİLİT</span><img src="~/img/hb-a1ms.jpg" alt="HB-A1Ms"></div>
      <div class="body">
        <div class="model">HB-A1Ms</div>
        <h3>Patlamaya Dayanıklı İkincil Kilit (Sub-Lock)</h3>
        <ul><li>Ana kilitle Bluetooth üzerinden haberleşir</li><li>90 gün bekleme süresi</li><li>494 g, IP67, Ex-proof koruma</li></ul>
        <div class="more"><span>İncele →</span><span>PDF föy</span></div>
      </div>
    </a>
    <a class="pcard" href="#">
      <div class="pic"><span class="tag">FİLO</span><img src="~/img/hb-vt08.jpg" alt="HB-VT08"></div>
      <div class="body">
        <div class="model">HB-VT08</div>
        <h3>Video Telematik Sistemi</h3>
        <ul><li>4 kanallı akıllı video izleme</li><li>ADAS, DSM ve yolcu izleme kameraları</li><li>256 / 512 GB dahili depolama</li></ul>
        <div class="more"><span>İncele →</span><span>PDF föy</span></div>
      </div>
    </a>
  </div>
</div></section>

<section class="how"><div class="wrap">
  <div class="sec-head">
    <div><span class="eyebrow">Nasıl çalışır</span><h2>Kilitle, izle, yetkiyle aç</h2></div>
    <p>Kurulum için araçta kablolama gerekmez; kilit mıknatısla yapışır ve kendi bataryasıyla çalışır.</p>
  </div>
  <div class="steps">
    <div class="step"><h3>Kilitle</h3><p>Çelik halatı kapı koluna geçirip kilidi kapatın. Kilit o andan itibaren konumunu ve durumunu merkeze bildirmeye başlar.</p></div>
    <div class="step"><h3>İzle</h3><p>Yük yoldayken konumu ve kilit durumunu panelden ya da mobil uygulamadan takip edin. Yetkisiz müdahalede akıllı alarm anında haber verir.</p></div>
    <div class="step"><h3>Yetkiyle aç</h3><p>Kilit yalnızca tanımlı kart, telefon ya da merkezden verilen komutla açılır. Kimin, nerede, ne zaman açtığı kayıtlıdır.</p>
      <div class="modes"><span>RFID kart</span><span>Bluetooth mobil</span><span>4G uzaktan</span></div></div>
  </div>
</div></section>

<section id="cozumler"><div class="wrap">
  <div class="sec-head">
    <div><span class="eyebrow">Çözümler</span><h2>Yükünüz neyse, kilidi ona göre</h2></div>
    <p>Aynı altyapı farklı taşıma türlerine uyarlanır. Kullanım alanınızı seçin, uygun ürünü birlikte belirleyelim.</p>
  </div>
  <div class="sgrid">
    <a class="scard" href="#"><div class="ic"><svg class="i"><use href="#box"/></svg></div><h3>Konteyner</h3><p>Limandan depoya kadar kapı mührü ve konum takibi tek cihazda.</p></a>
    <a class="scard" href="#"><div class="ic"><svg class="i"><use href="#tanker"/></svg></div><h3>Tanker</h3><p>Dolum ve boşaltma kapaklarında ATEX uyumlu, zincirleme kilitleme.</p></a>
    <a class="scard" href="#"><div class="ic"><svg class="i"><use href="#truck"/></svg></div><h3>Lojistik Aracı</h3><p>Kasa kapısı kilidi ve araç içi video telematik ile sürüş güvenliği.</p></a>
    <a class="scard" href="#"><div class="ic"><svg class="i"><use href="#safe"/></svg></div><h3>Kasa</h3><p>Çelik kasalarda yetkili kişi dışında açılmayan, kayıt tutan kilit.</p></a>
    <a class="scard" href="#"><div class="ic"><svg class="i"><use href="#customs"/></svg></div><h3>Gümrük Kargo Takibi</h3><p>Transit yüklerde güzergâh boyunca kesintisiz izleme ve açma kaydı.</p></a>
  </div>
</div></section>

<div class="trust"><div class="wrap"><div class="box">
  <div>
    <span class="eyebrow">Sertifikalar</span>
    <h2>Zorlu sahalar için tasarlandı</h2>
    <p>Kilitlerimiz −30 °C ile +70 °C arasında sorunsuz çalışır, toza ve suya karşı korumalıdır ve patlayıcı ortamlarda kullanım için sertifikalıdır.</p>
  </div>
  <div class="certs">
    <div class="cert"><b>CE</b><span>Güvenlik ve çevre standartları</span></div>
    <div class="cert"><b>ATEX</b><span>Patlayıcı ortamlara uygun</span></div>
    <div class="cert"><b>IP67</b><span>Toz ve su geçirmez</span></div>
  </div>
</div></div></div>

<section class="quote" id="teklif"><div class="wrap">
  <div>
    <span class="eyebrow">Teklif İste</span>
    <h2>Filonuza uygun çözümü <em>birlikte</em> belirleyelim</h2>
    <p>Araç sayınızı ve kullanım alanınızı yazın; satış ekibimiz size uygun ürün ve fiyat teklifiyle dönsün.</p>
    <ul class="clist">
      <li><svg class="i"><use href="#phone"/></svg><span><small>Satış · Serkan Gündoğdu</small>+90 542 432 10 10</span></li>
      <li><svg class="i"><use href="#mail"/></svg><span><small>E-posta</small>info@locktech.com.tr</span></li>
      <li><svg class="i"><use href="#pin"/></svg><span><small>Adres</small>İvedik OSB 1362 Cadde No:34, Yenimahalle / ANKARA</span></li>
    </ul>
  </div>
  <form method="post" asp-fragment="teklif">
    <h3>Teklif formu</h3>
    @if (Model.Gonderildi)
    {
        <p class="form-msg ok">Talebiniz bize ulaştı. En kısa sürede size dönüş yapacağız.</p>
    }
    @if (Model.Hata is not null)
    {
        <p class="form-msg err">@Model.Hata</p>
    }
    <label>Ad Soyad<input asp-for="Form.AdSoyad" placeholder="Adınız" autocomplete="name"><span asp-validation-for="Form.AdSoyad"></span></label>
    <label>Firma<input asp-for="Form.Firma" placeholder="Firma adı" autocomplete="organization"></label>
    <label>Telefon<input asp-for="Form.Telefon" type="tel" placeholder="05xx xxx xx xx" autocomplete="tel"><span asp-validation-for="Form.Telefon"></span></label>
    <label>E-posta<input asp-for="Form.Eposta" type="email" placeholder="ornek@firma.com" autocomplete="email"><span asp-validation-for="Form.Eposta"></span></label>
    <label class="full">İlgilendiğiniz ürün
      <select asp-for="Form.Urun"><option>Emin değilim, öneri istiyorum</option><option>HB-A1SP — Güneş enerjili kilit</option><option>HB-A1M — Patlamaya dayanıklı kilit</option><option>HB-A1Ms — İkincil kilit</option><option>HB-VT08 — Video telematik</option></select></label>
    <label class="full">Mesajınız<textarea asp-for="Form.Mesaj" rows="3" placeholder="Araç / konteyner sayısı, kullanım alanı…"></textarea></label>
    <label class="bal" aria-hidden="true">Web siteniz<input asp-for="Form.WebSitesi" tabindex="-1" autocomplete="off"></label>
    <button class="btn btn-primary" type="submit">Teklif İste</button>
    <p class="note">Bilgileriniz yalnızca teklif hazırlamak için kullanılır.</p>
  </form>
</div></section>
