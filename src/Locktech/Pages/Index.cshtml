@page
@model IndexModel
@{
    ViewData["Title"] = S("Locktech — Akıllı Kilit Sistemleri | GPS Takipli Elektronik Kilit", "Locktech — Smart Lock Systems | GPS-Tracked Electronic Locks");
    ViewData["Description"] = S(
        "Konteyner, tanker ve kamyon kasaları için 4G, GNSS, Bluetooth ve RFID destekli akıllı elektronik kilitler ve video telematik. Locktech, Ankara.",
        "Smart electronic locks with 4G, GNSS, Bluetooth and RFID, plus video telematics, for containers, tankers and truck bodies. Locktech, Ankara, Türkiye.");
    ViewData["Bolum"] = "ana";
    ViewData["Tr"] = "/";
    ViewData["En"] = "/en";
}

<div class="hero"><div class="wrap">
  <div>
    <span class="eyebrow">4G · GNSS · Bluetooth · RFID</span>
    @if (En)
    {
        <h1>Smart Security,<br>the <em>New Standard</em> in Logistics</h1>
        <p class="lead">Keep track of your containers, tankers and truck bodies wherever they are. Locktech electronic locks report their location in real time, open only for authorised people and alert you the moment someone tampers with them.</p>
    }
    else
    {
        <h1>Akıllı Güvenlik,<br>Lojistikte <em>Yeni Standart</em></h1>
        <p class="lead">Konteyner, tanker ve kamyon kasalarınızı nerede olursa olsun izleyin. Locktech elektronik kilitleri konumu anlık bildirir, yalnızca yetkili kişiye açılır ve müdahale edildiği anda size haber verir.</p>
    }
    <div class="cta">
      <a class="btn btn-primary" href="@Yollar.Teklif()">@S("Teklif İste", "Get a Quote") <svg class="i"><use href="#arrow"/></svg></a>
      <a class="btn btn-ghost" href="@Yollar.Urunler">@S("Ürünleri İncele", "View Products")</a>
    </div>
    <div class="chips">
      <span>@S("IP67 su geçirmez", "IP67 waterproof")</span>
      <span>@S("ATEX · Ex-proof gövde", "ATEX · Ex-proof housing")</span>
      <span>CE</span>
      <span>@S("1.000 kg kilit mili dayanımı", "1,000 kg shackle strength")</span>
    </div>
  </div>
  <div class="stage">
    <svg class="scene" viewBox="0 0 600 520" aria-hidden="true">
      <defs>
        <radialGradient id="sahne-isik" cx="50%" cy="50%" r="50%"><stop offset="0" stop-color="#1f7bff" stop-opacity=".55"/><stop offset="1" stop-color="#1f7bff" stop-opacity="0"/></radialGradient>
        <linearGradient id="rota-renk" x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="#27d3f5"/><stop offset="1" stop-color="#ff8a00"/></linearGradient>
        <pattern id="nokta" width="18" height="18" patternUnits="userSpaceOnUse"><circle cx="2" cy="2" r="1.3" fill="#7fb2ff"/></pattern>
        <radialGradient id="nokta-maske-renk" cx="50%" cy="50%" r="50%"><stop offset=".25" stop-color="#fff"/><stop offset="1" stop-color="#000"/></radialGradient>
        <mask id="nokta-maske"><rect width="600" height="520" fill="url(#nokta-maske-renk)"/></mask>
      </defs>
      <circle cx="300" cy="270" r="250" fill="url(#sahne-isik)"/>
      <rect width="600" height="520" fill="url(#nokta)" mask="url(#nokta-maske)" opacity=".5"/>
      <g class="yorunge" fill="none" stroke="#27d3f5">
        <circle class="y1" cx="300" cy="270" r="205" stroke-opacity=".35" stroke-dasharray="3 12" stroke-width="2"/>
        <circle class="y2" cx="300" cy="270" r="238" stroke-opacity=".22" stroke-dasharray="60 26" stroke-width="5"/>
        <circle cx="300" cy="270" r="172" stroke-opacity=".3"/>
      </g>
      <g class="ag" stroke="#7fb2ff" stroke-opacity=".28" fill="#7fb2ff">
        <path d="M70 120 150 70 250 96M470 440 540 380 560 300M60 330 110 400" fill="none"/>
        <circle cx="70" cy="120" r="3"/><circle cx="150" cy="70" r="3"/><circle cx="250" cy="96" r="3"/>
        <circle cx="470" cy="440" r="3"/><circle cx="540" cy="380" r="3"/><circle cx="560" cy="300" r="3"/>
        <circle cx="60" cy="330" r="3"/><circle cx="110" cy="400" r="3"/>
      </g>
      <path id="rota" d="M40 455C150 420 170 300 290 300S470 190 565 75" fill="none" stroke="#7fb2ff" stroke-opacity=".35" stroke-width="2" stroke-dasharray="2 9" stroke-linecap="round"/>
      <path class="rota-iz" d="M40 455C150 420 170 300 290 300S470 190 565 75" fill="none" stroke="url(#rota-renk)" stroke-width="3.5" stroke-linecap="round" pathLength="100"/>
      <g class="durak"><circle class="halka" cx="40" cy="455" r="7"/><circle cx="40" cy="455" r="5"/><text x="54" y="475">Ankara</text></g>
      <g class="durak son"><circle class="halka" cx="565" cy="75" r="7"/><circle cx="565" cy="75" r="5"/><text x="512" y="58">Mersin</text></g>
      <g class="arac">
        <circle r="16" fill="#ff8a00" opacity=".22"/><circle r="6.5" fill="#ff8a00" stroke="#fff" stroke-width="2"/>
        <animateMotion dur="9s" repeatCount="indefinite" calcMode="spline" keyTimes="0;1" keySplines=".45 0 .55 1"><mpath href="#rota"/></animateMotion>
      </g>
    </svg>
    <div class="sweep"></div>
    <div class="ring"></div>
    <div class="card"><img src="~/img/hb-a1sp.jpg" alt="@S("HB-A1SP güneş enerjili elektronik kilit", "HB-A1SP solar-powered electronic lock")"></div>
    <div class="float f1"><span class="dot"></span><div class="feed"><div class="roll">
      <span class="row"><small>@S("Kilit durumu", "Lock status")</small><b>@S("Kilitli", "Locked")</b></span>
      <span class="row"><small>@S("Kilit açıldı", "Unlocked")</small><b>@S("RFID kart · Depo girişi", "RFID card · Warehouse gate")</b></span>
      <span class="row"><small>@S("Batarya", "Battery")</small><b>@S("%92 · Güneş şarjı", "92% · Solar charging")</b></span>
      <span class="row"><small>@S("Halat", "Cable")</small><b>@S("Sağlam · Müdahale yok", "Intact · No tampering")</b></span>
      <span class="row"><small>@S("Kilit durumu", "Lock status")</small><b>@S("Kilitli", "Locked")</b></span>
    </div></div></div>
    <div class="float f2"><svg class="i"><use href="#pin"/></svg><div class="feed"><div class="roll">
      <span class="row"><small>@S("Canlı konum", "Live location")</small><b>Ankara → Mersin</b></span>
      <span class="row"><small>@S("Şu an", "Right now")</small><b>@S("Aksaray · 82 km/s", "Aksaray · 82 km/h")</b></span>
      <span class="row"><small>@S("Varışa kalan", "To destination")</small><b>@S("214 km · 2 sa 40 dk", "214 km · 2 h 40 min")</b></span>
      <span class="row"><small>@S("Son veri", "Last update")</small><b>@S("12 saniye önce", "12 seconds ago")</b></span>
      <span class="row"><small>@S("Canlı konum", "Live location")</small><b>Ankara → Mersin</b></span>
    </div></div></div>
    <div class="float f3"><svg class="i"><use href="#bell"/></svg><div class="feed"><div class="roll">
      <span class="row"><small>@S("Bildirim", "Alert")</small><b>@S("Yetkisiz açma denemesi", "Unauthorised opening attempt")</b></span>
      <span class="row"><small>@S("Bildirim", "Alert")</small><b>@S("Güzergâh dışına çıkıldı", "Vehicle left the route")</b></span>
      <span class="row"><small>@S("Bildirim", "Alert")</small><b>@S("Kilit uzaktan açıldı", "Lock opened remotely")</b></span>
      <span class="row"><small>@S("Bildirim", "Alert")</small><b>@S("Teslimat noktasına varıldı", "Arrived at delivery point")</b></span>
      <span class="row"><small>@S("Bildirim", "Alert")</small><b>@S("Yetkisiz açma denemesi", "Unauthorised opening attempt")</b></span>
    </div></div></div>
  </div>
</div></div>

<div class="strip"><div class="wrap"><div class="grid">
  <div class="cell"><svg class="i"><use href="#pin"/></svg>@S("GPS Takip", "GPS Tracking")</div>
  <div class="cell"><svg class="i"><use href="#mobile"/></svg>@S("Mobil Kontrol", "Mobile Control")</div>
  <div class="cell"><svg class="i"><use href="#card"/></svg>@S("Kartlı Erişim", "Card Access")</div>
  <div class="cell"><svg class="i"><use href="#monitor"/></svg>@S("Merkezi Yönetim", "Central Management")</div>
  <div class="cell"><svg class="i"><use href="#bell"/></svg>@S("Anlık Bildirim", "Instant Alerts")</div>
  <div class="cell"><svg class="i"><use href="#link"/></svg>@S("Çoklu Kilit Zincirleme", "Multi-Lock Cascading")</div>
</div></div></div>

<section class="products" id="urunler"><div class="wrap">
  <div class="sec-head">
    <div><span class="eyebrow">@S("Ürünler", "Products")</span><h2>@S("Dört ürün, uçtan uca yük güvenliği", "Four products, end-to-end cargo security")</h2></div>
    <p>@S("Ana kilit, ikincil kilit ve araç içi video telematik. Her ürünün teknik özelliklerini kendi sayfasından PDF olarak indirebilirsiniz.", "A main lock, a secondary lock and in-vehicle video telematics. Download each product's specifications as a PDF from its own page.")</p>
  </div>
  <div class="pgrid">
    @foreach (var urun in UrunKatalogu.Tumu)
    {
        <partial name="_UrunKarti" model="urun" />
    }
  </div>
</div></section>

<section class="how"><div class="wrap">
  <div class="sec-head">
    <div><span class="eyebrow">@S("Nasıl çalışır", "How it works")</span><h2>@S("Kilitle, izle, yetkiyle aç", "Lock, track, open with authorisation")</h2></div>
    <p>@S("Kurulum için araçta kablolama gerekmez; kilit mıknatısla yapışır ve kendi bataryasıyla çalışır.", "No wiring is needed in the vehicle: the lock attaches magnetically and runs on its own battery.")</p>
  </div>
  <div class="steps">
    <div class="step"><h3>@S("Kilitle", "Lock")</h3><p>@S("Çelik halatı kapı koluna geçirip kilidi kapatın. Kilit o andan itibaren konumunu ve durumunu merkeze bildirmeye başlar.", "Pass the steel cable through the door handle and close the lock. From that moment it reports its location and status to the control centre.")</p></div>
    <div class="step"><h3>@S("İzle", "Track")</h3><p>@S("Yük yoldayken konumu ve kilit durumunu panelden ya da mobil uygulamadan takip edin. Yetkisiz müdahalede akıllı alarm anında haber verir.", "While the load is on the road, follow its location and lock status from the dashboard or the mobile app. The smart alarm notifies you immediately of any tampering.")</p></div>
    <div class="step"><h3>@S("Yetkiyle aç", "Open with authorisation")</h3><p>@S("Kilit yalnızca tanımlı kart, telefon ya da merkezden verilen komutla açılır.", "The lock opens only with a registered card, a phone, or a command from the control centre.")</p>
      <div class="modes"><span>@S("RFID kart", "RFID card")</span><span>@S("Bluetooth mobil", "Bluetooth mobile")</span><span>@S("4G uzaktan", "4G remote")</span></div></div>
  </div>
</div></section>

<section id="cozumler"><div class="wrap">
  <div class="sec-head">
    <div><span class="eyebrow">@S("Çözümler", "Solutions")</span><h2>@S("Yükünüz neyse, kilidi ona göre", "The right lock for whatever you carry")</h2></div>
    <p>@S("Aynı altyapı farklı taşıma türlerine uyarlanır. Kullanım alanınızı seçin, uygun ürünü birlikte belirleyelim.", "The same platform adapts to different kinds of transport. Pick your use case and we will find the right product together.")</p>
  </div>
  <div class="sgrid">
    @foreach (var cozum in CozumKatalogu.Tumu)
    {
        <partial name="_CozumKarti" model="cozum" />
    }
  </div>
</div></section>

<div class="trust"><div class="wrap"><div class="box">
  <div>
    <span class="eyebrow">@S("Sertifikalar", "Certifications")</span>
    <h2>@S("Zorlu sahalar için tasarlandı", "Designed for demanding sites")</h2>
    <p>@S("Kilitlerimiz −30 °C ile +70 °C arasında sorunsuz çalışır, toza ve suya karşı korumalıdır ve patlayıcı ortamlarda kullanım için sertifikalıdır.", "Our locks operate reliably from −30 °C to +70 °C, are protected against dust and water, and are certified for use in explosive atmospheres.")</p>
  </div>
  <div class="certs">
    <div class="cert"><b>CE</b><span>@S("Güvenlik ve çevre standartları", "Safety and environmental standards")</span></div>
    <div class="cert"><b>ATEX</b><span>@S("Patlayıcı ortamlara uygun", "Suitable for explosive atmospheres")</span></div>
    <div class="cert"><b>IP67</b><span>@S("Toz ve su geçirmez", "Dust-tight and waterproof")</span></div>
  </div>
</div></div></div>

<section class="quote" id="teklif"><div class="wrap">
  <partial name="_TeklifBilgisi" />
  <partial name="_TeklifFormu" model="Model" />
</div></section>
