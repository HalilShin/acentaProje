@inject Locktech.Ayarlar.AyarDeposu AyarDeposu
@{
    var ayarlar = AyarDeposu.Al();
    var bolum = ViewData["Bolum"] as string;
    // Her sayfa kendi Türkçe ve İngilizce adresini bildirir; dil geçişi ve hreflang bunları kullanır.
    var trYol = ViewData["Tr"] as string;
    var enYol = ViewData["En"] as string;
    var aciklama = ViewData["Description"] as string;
}
<!doctype html>
<html lang="@(En ? "en" : "tr")">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"]</title>
    @if (!string.IsNullOrEmpty(aciklama))
    {
        <meta name="description" content="@aciklama">
    }
    @if (trYol is not null && enYol is not null)
    {
        <link rel="canonical" href="@(Site.Adres)@(En ? enYol : trYol)">
        <link rel="alternate" hreflang="tr" href="@(Site.Adres)@trYol">
        <link rel="alternate" hreflang="en" href="@(Site.Adres)@enYol">
        <link rel="alternate" hreflang="x-default" href="@(Site.Adres)@trYol">
    }
    else
    {
        <meta name="robots" content="noindex">
    }
    <link rel="icon" href="~/favicon.ico" asp-append-version="true">
    <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>
<body>

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <symbol id="pin" viewBox="0 0 24 24"><path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></symbol>
    <symbol id="phone" viewBox="0 0 24 24"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A15 15 0 0 1 3 6a2 2 0 0 1 2-2z"/></symbol>
    <symbol id="mail" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></symbol>
    <symbol id="mobile" viewBox="0 0 24 24"><rect x="7" y="2.5" width="10" height="19" rx="2.5"/><path d="M11 18.5h2"/></symbol>
    <symbol id="card" viewBox="0 0 24 24"><rect x="2.5" y="5" width="19" height="14" rx="2.5"/><path d="M2.5 10h19M6.5 15h4"/></symbol>
    <symbol id="monitor" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></symbol>
    <symbol id="bell" viewBox="0 0 24 24"><path d="M6 16V11a6 6 0 0 1 12 0v5l2 2H4l2-2zM10 21h4"/></symbol>
    <symbol id="link" viewBox="0 0 24 24"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3A4 4 0 0 0 11 18.7l1-1"/></symbol>
    <symbol id="shield" viewBox="0 0 24 24"><path d="M12 3 5 6v5.5c0 4.3 3 7.7 7 9.5 4-1.8 7-5.2 7-9.5V6l-7-3z"/><path d="m9 12 2.2 2.2L15.5 10"/></symbol>
    <symbol id="box" viewBox="0 0 24 24"><rect x="2.5" y="6" width="19" height="12" rx="1.5"/><path d="M7 6v12M12 6v12M17 6v12"/></symbol>
    <symbol id="tanker" viewBox="0 0 24 24"><rect x="2.5" y="7" width="13" height="8" rx="4"/><path d="M15.5 10h3.5l2.5 3v3h-6M2.5 16h19"/><circle cx="7" cy="18" r="1.8"/><circle cx="18" cy="18" r="1.8"/></symbol>
    <symbol id="truck" viewBox="0 0 24 24"><path d="M2.5 6h12v10h-12zM14.5 9.5H19l2.5 3.5v3h-7"/><circle cx="7" cy="18" r="1.8"/><circle cx="18" cy="18" r="1.8"/></symbol>
    <symbol id="safe" viewBox="0 0 24 24"><rect x="3.5" y="3.5" width="17" height="16" rx="2"/><circle cx="12" cy="11.5" r="3.5"/><path d="M12 8v1.5M12 13.5V15M7 19.5V21M17 19.5V21"/></symbol>
    <symbol id="customs" viewBox="0 0 24 24"><path d="M12 3 4 7v5l8 4 8-4V7l-8-4zM4 12v5l8 4 8-4v-5M12 11v10"/></symbol>
    <symbol id="arrow" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></symbol>
    <symbol id="download" viewBox="0 0 24 24"><path d="M12 4v11M7 11l5 5 5-5M5 20h14"/></symbol>
    <symbol id="check" viewBox="0 0 24 24"><path d="m5 12.5 4.5 4.5L19 7.5"/></symbol>
    <symbol id="menu" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"/></symbol>
    <symbol id="alert" viewBox="0 0 24 24"><path d="M12 4 2.5 20h19L12 4zM12 10v4.5M12 17.2v.3"/></symbol>
  </defs>
</svg>

<div class="topbar"><div class="wrap">
  <div class="contact">
    <a href="@Site.TelefonBaglantisi"><svg class="i"><use href="#phone"/></svg>@Site.Telefon</a>
    <a href="mailto:@Site.Eposta"><svg class="i"><use href="#mail"/></svg>@Site.Eposta</a>
  </div>
  <div class="lang">
    <a class="@(En ? null : "on")" href="@(trYol ?? "/")" lang="tr" hreflang="tr">TR</a>
    <a class="@(En ? "on" : null)" href="@(enYol ?? "/en")" lang="en" hreflang="en">EN</a>
  </div>
</div></div>

<header class="nav"><div class="wrap">
  <a class="logo" href="@Yollar.Ana">
    <span class="mark"></span>
    <span><b>LOCK<i>TECH</i></b><small>@S("AKILLI KİLİT SİSTEMLERİ", "SMART LOCK SYSTEMS")</small></span>
  </a>
  <input type="checkbox" id="menu-ac" aria-hidden="true">
  <nav class="menu">
    <a class="@(bolum == "ana" ? "on" : null)" href="@Yollar.Ana">@S("Ana Sayfa", "Home")</a>
    <a class="@(bolum == "urunler" ? "on" : null)" href="@Yollar.Urunler">@S("Ürünler", "Products")</a>
    <a class="@(bolum == "cozumler" ? "on" : null)" href="@Yollar.Cozumler">@S("Çözümler", "Solutions")</a>
    <a class="@(bolum == "hakkimizda" ? "on" : null)" href="@Yollar.Hakkimizda">@S("Hakkımızda", "About")</a>
    <a class="@(bolum == "iletisim" ? "on" : null)" href="@Yollar.Iletisim">@S("İletişim", "Contact")</a>
  </nav>
  <div class="nav-end">
    <a class="btn btn-primary" href="@Yollar.Teklif()">@S("Teklif İste", "Get a Quote")</a>
    <label class="burger" for="menu-ac" aria-label="@S("Menü", "Menu")"><svg class="i"><use href="#menu"/></svg></label>
  </div>
</div></header>

<main>
@RenderBody()
</main>

<footer><div class="wrap">
  <div class="cols">
    <div>
      <a class="logo" href="@Yollar.Ana"><span class="mark"></span><span><b>LOCK<i>TECH</i></b><small>@S("AKILLI KİLİT SİSTEMLERİ", "SMART LOCK SYSTEMS")</small></span></a>
      <p style="margin-top:16px;max-width:34ch">@S("Lojistik ve taşımacılık için akıllı kilit ve araç telematiği çözümleri.", "Smart lock and vehicle telematics solutions for logistics and transport.")</p>
    </div>
    <div><h4>@S("Ürünler", "Products")</h4><ul>
      @foreach (var urun in UrunKatalogu.Tumu)
      {
          <li><a href="@urun.Adres">@urun.Model</a></li>
      }
    </ul></div>
    <div><h4>@S("Çözümler", "Solutions")</h4><ul>
      @foreach (var cozum in CozumKatalogu.Tumu)
      {
          <li><a href="@cozum.Adres">@cozum.Ad</a></li>
      }
    </ul></div>
    <div><h4>@S("İletişim", "Contact")</h4><ul>
      <li>İvedik OSB 1362 Cadde No:34<br>Yenimahalle / ANKARA</li>
      <li><a href="@Site.TelefonBaglantisi">@Site.Telefon</a></li>
      <li><a href="mailto:@Site.Eposta">@Site.Eposta</a></li>
      <li><a href="@Yollar.Hakkimizda">@S("Hakkımızda", "About us")</a></li>
    </ul></div>
  </div>
  <div class="copy">
    <span>© @DateTime.Now.Year Locktech. @S("Tüm hakları saklıdır.", "All rights reserved.")</span>
    <span><a href="@Yollar.Kvkk">@S("KVKK Aydınlatma Metni", "Privacy Notice")</a> · <a href="@Yollar.Cerez">@S("Çerez Politikası", "Cookie Policy")</a></span>
  </div>
</div></footer>

@if (ayarlar.WhatsAppGoster && ayarlar.WhatsAppBaglantisi is { } waLink)
{
    <a class="wa" href="@waLink" target="_blank" rel="noopener" aria-label="@S("WhatsApp ile yazın", "Chat on WhatsApp")">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 0 0-7.7 13.6L3 21l4.5-1.2A9 9 0 1 0 12 3z"/><path d="M9 8.5c-.4 2.8 3.7 6.9 6.5 6.5l.8-1.6-2-1-.9.9c-1.1-.5-2.2-1.6-2.7-2.7l.9-.9-1-2L9 8.5z"/></svg>
        <span>WhatsApp</span>
    </a>
}

</body>
</html>
