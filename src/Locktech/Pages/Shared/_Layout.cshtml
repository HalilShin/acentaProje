@inject Locktech.Ayarlar.AyarDeposu AyarDeposu
@{
    var ayarlar = AyarDeposu.Al();
    var yol = Context.Request.Path.Value ?? "/";
    var urunlerde = yol.StartsWith("/urunler", StringComparison.OrdinalIgnoreCase);
}
<!doctype html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"]</title>
    <meta name="description" content="@ViewData["Description"]">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Exo+2:ital,wght@0,600;0,700;1,700;1,800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>
<body>

<svg width="0" height="0" style="position:absolute">
  <defs>
    <symbol id="pin" viewBox="0 0 24 24"><path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.500C5 14.800 12 21 12 21z"/><circle cx="12" cy="9.500" r="2.500"/></symbol>
    <symbol id="phone" viewBox="0 0 24 24"><path d="M5 4h4l2 5-2.500 1.500a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A15 15 0 0 1 3 6a2 2 0 0 1 2-2z"/></symbol>
    <symbol id="mail" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></symbol>
    <symbol id="mobile" viewBox="0 0 24 24"><rect x="7" y="2.500" width="10" height="19" rx="2.500"/><path d="M11 18.500h2"/></symbol>
    <symbol id="card" viewBox="0 0 24 24"><rect x="2.500" y="5" width="19" height="14" rx="2.500"/><path d="M2.500 10h19M6.500 15h4"/></symbol>
    <symbol id="monitor" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></symbol>
    <symbol id="bell" viewBox="0 0 24 24"><path d="M6 16V11a6 6 0 0 1 12 0v5l2 2H4l2-2zM10 21h4"/></symbol>
    <symbol id="link" viewBox="0 0 24 24"><path d="M10 14a4 4 0 0 0 5.700 0l3-3a4 4 0 0 0-5.700-5.700l-1 1M14 10a4 4 0 0 0-5.700 0l-3 3A4 4 0 0 0 11 18.700l1-1"/></symbol>
    <symbol id="shield" viewBox="0 0 24 24"><path d="M12 3 5 6v5.500c0 4.300 3 7.700 7 9.500 4-1.800 7-5.200 7-9.500V6l-7-3z"/><path d="m9 12 2.200 2.200L15.500 10"/></symbol>
    <symbol id="box" viewBox="0 0 24 24"><rect x="2.500" y="6" width="19" height="12" rx="1.500"/><path d="M7 6v12M12 6v12M17 6v12"/></symbol>
    <symbol id="tanker" viewBox="0 0 24 24"><rect x="2.500" y="7" width="13" height="8" rx="4"/><path d="M15.500 10h3.500l2.500 3v3h-6M2.500 16h19"/><circle cx="7" cy="18" r="1.800"/><circle cx="18" cy="18" r="1.800"/></symbol>
    <symbol id="truck" viewBox="0 0 24 24"><path d="M2.500 6h12v10h-12zM14.500 9.500H19l2.500 3.500v3h-7"/><circle cx="7" cy="18" r="1.800"/><circle cx="18" cy="18" r="1.800"/></symbol>
    <symbol id="safe" viewBox="0 0 24 24"><rect x="3.500" y="3.500" width="17" height="16" rx="2"/><circle cx="12" cy="11.500" r="3.500"/><path d="M12 8v1.500M12 13.500V15M7 19.500V21M17 19.500V21"/></symbol>
    <symbol id="customs" viewBox="0 0 24 24"><path d="M12 3 4 7v5l8 4 8-4V7l-8-4zM4 12v5l8 4 8-4v-5M12 11v10"/></symbol>
    <symbol id="arrow" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></symbol>
    <symbol id="download" viewBox="0 0 24 24"><path d="M12 4v11M7 11l5 5 5-5M5 20h14"/></symbol>
    <symbol id="check" viewBox="0 0 24 24"><path d="m5 12.500 4.500 4.500L19 7.500"/></symbol>
    <symbol id="clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.500"/><path d="M12 7.500V12l3 2"/></symbol>
  </defs>
</svg>

<div class="topbar"><div class="wrap">
  <div class="contact">
    <span><svg class="i"><use href="#phone"/></svg>+90 542 432 10 10</span>
    <span><svg class="i"><use href="#mail"/></svg>info@locktech.com.tr</span>
  </div>
  <div class="lang"><a class="on" href="#">TR</a><a href="#">EN</a></div>
</div></div>

<header class="nav"><div class="wrap">
  <a class="logo" href="/">
    <span class="mark"></span>
    <span><b>LOCK<i>TECH</i></b><small>AKILLI KİLİT SİSTEMLERİ</small></span>
  </a>
  <nav class="menu">
    <a class="@(yol == "/" ? "on" : null)" href="/">Ana Sayfa</a><a class="@(urunlerde ? "on" : null)" href="/urunler">Ürünler</a><a href="/#cozumler">Çözümler</a><a href="#">Hakkımızda</a><a href="/#teklif">İletişim</a>
  </nav>
  <a class="btn btn-primary" href="/#teklif">Teklif İste</a>
</div></header>

<main>
@RenderBody()
</main>

<footer><div class="wrap">
  <div class="cols">
    <div>
      <a class="logo" href="/"><span class="mark"></span><span><b>LOCK<i>TECH</i></b><small>AKILLI KİLİT SİSTEMLERİ</small></span></a>
      <p style="margin-top:16px;max-width:34ch">Lojistik ve taşımacılık için akıllı kilit ve araç telematiği çözümleri.</p>
    </div>
    <div><h4>Ürünler</h4><ul>@foreach (var urun in UrunKatalogu.Tumu) { <li><a href="@urun.Adres">@urun.Model</a></li> }</ul></div>
    <div><h4>Kurumsal</h4><ul><li><a href="/#cozumler">Çözümler</a></li><li><a href="#">Hakkımızda</a></li><li><a href="/#teklif">İletişim</a></li><li><a href="#">English</a></li></ul></div>
    <div><h4>İletişim</h4><ul><li>İvedik OSB 1362 Cadde No:34<br>Yenimahalle / ANKARA</li><li>+90 542 432 10 10</li><li>info@locktech.com.tr</li></ul></div>
  </div>
  <div class="copy"><span>© @DateTime.Now.Year Locktech. Tüm hakları saklıdır.</span><span>KVKK Aydınlatma Metni · Çerez Politikası</span></div>
</div></footer>

@if (ayarlar.WhatsAppGoster && ayarlar.WhatsAppBaglantisi is { } waLink)
{
    <a class="wa" href="@waLink" target="_blank" rel="noopener" aria-label="WhatsApp ile yazın">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 0 0-7.700 13.600L3 21l4.500-1.200A9 9 0 1 0 12 3z"/><path d="M9 8.500c-.400 2.800 3.700 6.900 6.500 6.500l.800-1.600-2-1-.900.900c-1.100-.500-2.200-1.600-2.700-2.700l.900-.900-1-2L9 8.500z"/></svg>
        <span>WhatsApp</span>
    </a>
}

</body>
</html>