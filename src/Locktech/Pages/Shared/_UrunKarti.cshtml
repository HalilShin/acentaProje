@model Urun

<a class="pcard" href="@Model.Adres">
    <div class="pic"><span class="tag @(Model.EtiketVurgulu ? "o" : "")">@Model.Etiket</span><img src="@Model.Gorsel" alt="@Model.Model @Model.Ad" loading="lazy"></div>
    <div class="body">
        <div class="model">@Model.Model</div>
        <h3>@Model.Ad</h3>
        <ul>
            @foreach (var madde in Model.KartMaddeleri)
            {
                <li>@madde</li>
            }
        </ul>
        <div class="more"><span>@S("İncele", "View") →</span><span>@S("PDF indir", "PDF")</span></div>
    </div>
</a>
