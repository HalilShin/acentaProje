@{
    var m = Baglam.Marka;
    var a = AyarDeposu.Al();
    var bolum = ViewData["Bolum"] as string;
    var yol = ViewData["Yol"] as string;
    var aciklama = ViewData["Description"] as string;
    var wa = a.WhatsAppGoster ? a.WhatsAppBaglantisi(m.WhatsAppMesaj) : null;
    ViewData["WhatsApp"] = wa;
}
<!doctype html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"]</title>
    @if (!string.IsNullOrEmpty(aciklama))
    {
        <meta name="description" content="@aciklama">
    }
    @if (yol is not null)
    {
        <link rel="canonical" href="@(m.SiteAdresi)@yol">
    }
    else
    {
        <meta name="robots" content="noindex">
    }
    <link rel="icon" type="image/svg+xml" href="/simge.svg?m=@m.Kod">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="@m.FontAdresi" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    <style>:root{--ana:@m.RenkAna;--koyu:@m.RenkKoyu;--vurgu:@m.RenkVurgu;--acik:@m.RenkAcik;--baslik:@Html.Raw(m.FontBaslik)}</style>
</head>
<body class="m-@m.Kod">

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <symbol id="i-telefon" viewBox="0 0 24 24"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A15 15 0 0 1 3 6a2 2 0 0 1 2-2z"/></symbol>
    <symbol id="i-posta" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></symbol>
    <symbol id="i-konum" viewBox="0 0 24 24"><path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></symbol>
    <symbol id="i-ok" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></symbol>
    <symbol id="i-onay" viewBox="0 0 24 24"><path d="m5 12.5 4.5 4.5L19 7.5"/></symbol>
    <symbol id="i-menu" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"/></symbol>
    <symbol id="i-kisiler" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c0-3.6 2.9-6 6.5-6s6.500 2.400 6.500 6M16 4.800a3.500 3.500 0 0 1 0 6.400M18 14.500c2.200.800 3.500 2.800 3.500 5.500"/></symbol>
    <symbol id="i-harita" viewBox="0 0 24 24"><path d="m3 6 6-2 6 2 6-2v14l-6 2-6-2-6 2V6zM9 4v14M15 6v14"/></symbol>
    <symbol id="i-takvim" viewBox="0 0 24 24"><rect x="3.500" y="5" width="17" height="15" rx="2"/><path d="M3.500 10h17M8 3v4M16 3v4M8 14h3"/></symbol>
    <symbol id="i-yol" viewBox="0 0 24 24"><path d="M8 3 4 21M16 3l4 18M12 4v3M12 11v3M12 18v3"/></symbol>
    <symbol id="i-otobus" viewBox="0 0 24 24"><rect x="4" y="3.500" width="16" height="14" rx="3"/><path d="M4 11h16M7 17.500V20M17 17.500V20M8 14.500h.01M16 14.500h.01"/></symbol>
    <symbol id="i-midibus" viewBox="0 0 24 24"><rect x="2.500" y="6" width="19" height="10" rx="2.500"/><path d="M2.500 11h19M9 6v5M15 6v5"/><circle cx="7.500" cy="17.500" r="1.800"/><circle cx="16.500" cy="17.500" r="1.800"/></symbol>
    <symbol id="i-minibus" viewBox="0 0 24 24"><path d="M3 16V8a2 2 0 0 1 2-2h9l5 4.500 2 .800V16H3zM14 6v4.500h5M8 6v4.500h6M3 10.500h5"/><circle cx="7.500" cy="17.500" r="1.800"/><circle cx="16.500" cy="17.500" r="1.800"/></symbol>
    <symbol id="i-kalp" viewBox="0 0 24 24"><path d="M12 20s-7.500-4.600-7.500-10.200A4.300 4.300 0 0 1 12 7a4.300 4.300 0 0 1 7.500 2.800C19.500 15.400 12 20 12 20z"/></symbol>
    <symbol id="i-okul" viewBox="0 0 24 24"><path d="m12 4 10 5-10 5L2 9l10-5zM6 11.500V16c0 1.500 2.700 3 6 3s6-1.500 6-3v-4.500M22 9v5"/></symbol>
    <symbol id="i-ucak" viewBox="0 0 24 24"><path d="M10.500 3.500c0-1 3-1 3 0V9l7.500 4.500v2L13.500 13v4.500l2.500 2V21l-4-1-4 1v-1.500l2.500-2V13L3 15.500v-2L10.500 9V3.500z"/></symbol>
    <symbol id="i-bina" viewBox="0 0 24 24"><path d="M5 21V5a2 2 0 0 1 2-2h7a2 2 0 0 1 2 2v16M16 9h2a2 2 0 0 1 2 2v10M3 21h18M9 7.500h3M9 11.500h3M9 15.500h3"/></symbol>
    <symbol id="i-yildiz" viewBox="0 0 24 24"><path d="m12 3.500 2.600 5.400 5.900.800-4.300 4.100 1.100 5.900L12 16.900l-5.300 2.800 1.100-5.900-4.300-4.100 5.900-.800L12 3.500z"/></symbol>
  </defs>
</svg>

<div class="ustbar"><div class="sarma">
  <span>@a.Adres</span>
  <div>
    @if (!string.IsNullOrWhiteSpace(a.Eposta))
    {
        <a href="mailto:@a.Eposta"><svg class="i"><use href="#i-posta"/></svg>@a.Eposta</a>
    }
    <a href="@a.TelefonBaglantisi"><svg class="i"><use href="#i-telefon"/></svg>@a.Telefon</a>
  </div>
</div></div>

<header class="ust"><div class="sarma">
  <partial name="_Logo" />
  <input type="checkbox" id="menu-ac" aria-hidden="true">
  <nav class="menu">
    <a class="@(bolum == "ana" ? "secili" : null)" href="/">Ana Sayfa</a>
    <a class="@(bolum == "hizmetler" ? "secili" : null)" href="/hizmetler">Hizmetler</a>
    <a class="@(bolum == "araclar" ? "secili" : null)" href="/arac-filosu">Araç Filosu</a>
    <a class="@(bolum == "hakkimizda" ? "secili" : null)" href="/hakkimizda">Hakkımızda</a>
    <a class="@(bolum == "iletisim" ? "secili" : null)" href="/iletisim">İletişim</a>
  </nav>
  <div class="ust-son">
    <a class="dugme" href="/iletisim#teklif">Teklif Al</a>
    <label class="burger" for="menu-ac" aria-label="Menü"><svg class="i"><use href="#i-menu"/></svg></label>
  </div>
</div></header>

<main>
@RenderBody()
</main>

<footer><div class="sarma">
  <div class="kolonlar">
    <div>
      <partial name="_Logo" />
      <p>@m.Aciklama</p>
    </div>
    <div><h4>Hizmetler</h4><ul>
      @foreach (var h in m.Hizmetler)
      {
          <li><a href="@h.Adres">@h.Ad</a></li>
      }
    </ul></div>
    <div><h4>Kurumsal</h4><ul>
      <li><a href="/arac-filosu">Araç Filosu</a></li>
      <li><a href="/hakkimizda">Hakkımızda</a></li>
      <li><a href="/iletisim">İletişim</a></li>
      <li><a href="/kvkk">KVKK Aydınlatma Metni</a></li>
      <li><a href="/cerez-politikasi">Çerez Politikası</a></li>
    </ul></div>
    <div><h4>İletişim</h4><ul>
      <li>@a.Adres</li>
      <li><a href="@a.TelefonBaglantisi">@a.Telefon</a></li>
      @if (!string.IsNullOrWhiteSpace(a.Eposta))
      {
          <li><a href="mailto:@a.Eposta">@a.Eposta</a></li>
      }
    </ul></div>
  </div>
  <div class="telif">© @DateTime.Now.Year @m.Ad. Tüm hakları saklıdır.</div>
</div></footer>

@if (wa is not null)
{
    <a class="wa" href="@wa" target="_blank" rel="noopener" aria-label="WhatsApp ile yazın">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 0 0-7.7 13.6L3 21l4.5-1.2A9 9 0 1 0 12 3z"/><path d="M9 8.5c-.4 2.8 3.7 6.9 6.5 6.5l.8-1.6-2-1-.9.9c-1.1-.5-2.2-1.6-2.7-2.7l.9-.9-1-2L9 8.5z"/></svg>
        <span>WhatsApp</span>
    </a>
}

</body>
</html>
