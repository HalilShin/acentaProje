@page "/arac-filosu"
@{
    var m = Baglam.Marka;
    ViewData["Title"] = $"{m.AraclarBaslik} | {m.Ad}";
    ViewData["Description"] = $"{m.Ad} araç filosu: {string.Join(", ", m.Araclar.Select(x => $"{x.Ad} ({x.Kapasite})"))}.";
    ViewData["Bolum"] = "araclar";
    ViewData["Yol"] = "/arac-filosu";
}

<partial name="_SayfaBasi" model='new SayfaBasi(m.AraclarBaslik, m.AraclarMetin, ("Araç Filosu", null))' />

<section><div class="sarma">
    <div class="filo">
        @foreach (var arac in m.Araclar)
        {
            <div class="filo-satir">
                <div class="cizim"><partial name="_AracGorseli" model="arac" /></div>
                <div>
                    <span class="kapasite">@arac.Tip · @arac.Kapasite</span>
                    <h2>@arac.Ad</h2>
                    <p>@arac.Aciklama</p>
                    <ul class="ozellikler">
                        @foreach (var o in arac.Ozellikler)
                        {
                            <li><svg class="i"><use href="#i-onay"/></svg>@o</li>
                        }
                    </ul>
                </div>
            </div>
        }
    </div>
    @{
        var kendi = m.Araclar.Where(x => FiloFotograflari.Bul(x.Ad)?.Kendi == true).Select(x => x.Ad.Replace("Mercedes-Benz ", "")).ToList();
        var kendiMetin = kendi.Count > 1 ? string.Join(", ", kendi.SkipLast(1)) + " ve " + kendi[^1] : string.Join("", kendi);
    }
    <p class="not">@kendiMetin fotoğrafları kendi araçlarımızdır; diğer fotoğraflar araç modellerini tanıtmak için temsilidir. Araç tipi; tarih, güzergâh ve kişi sayısına göre teklif aşamasında netleştirilir.</p>
    <div class="atif" id="fotograflar">
        <h3>Fotoğraf kaynakları</h3>
        <p>Temsili fotoğraflar Wikimedia Commons'tan, aşağıdaki lisanslarla alınmıştır. Plakalar ve başka firmalara ait yazılar bulanıklaştırılmış, fotoğraflar kırpılmış ve yeniden boyutlandırılmıştır.</p>
        <ul>
            @foreach (var arac in m.Araclar)
            {
                if (FiloFotograflari.Bul(arac.Ad) is { Kendi: false } foto)
                {
                    <li>@arac.Ad: <a href="@foto.KaynakAdresi" target="_blank" rel="noopener">@foto.Yazar</a>, <a href="@foto.LisansAdresi" target="_blank" rel="noopener license">@foto.Lisans</a></li>
                }
            }
        </ul>
    </div>
</div></section>

<partial name="_TeklifBandi" />
